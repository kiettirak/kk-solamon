# Solarman API
API_ID=your_app_id_here
API_SECRET=your_app_secret_here
BASE_URL=https://globalapi.solarmanpv.com
EMAIL=your_email@example.com
PASSWORD="your_password_here"

# InfluxDB (match docker-compose.yml)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=solar-super-secret-token
INFLUX_ORG=solar-org
INFLUX_BUCKET=solar-data

# MySQL
MYSQL_DSN=solar:solar1234@tcp(localhost:3306)/solardata?parseTime=true&loc=Asia%2FBangkok

# App Settings
POLL_MINUTES=10
LOG_LEVEL=info
OUTPUT_DIR=./output

# Weather - Open-Meteo ERA5-Land (free, no API key required)
# Station coordinates: Seka, Bueng Kan (update to match your actual station location)
WEATHER_LAT=17.93046324892076
WEATHER_LON=103.94864700242748
WEATHER_START_DATE=2023-05-23
WEATHER_BACKFILL=true